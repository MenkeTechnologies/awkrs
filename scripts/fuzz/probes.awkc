# Curated differential probes — read by scripts/fuzz_parity.sh.
#
# Format:
#   #=== <name>                 starts a case
#   #--- prog                   program text follows, up to the next directive
#   #--- in                     stdin text follows (optional)
#   #--- only <ref>[,<ref>]     restrict this probe to the named reference awks
#
# `#--- only` is NOT a failure allowlist. It exists for the handful of probes
# where the reference implementations disagree with *each other*, so there is no
# single ground truth to compare against; the directive records which references
# define the behavior awkrs targets. Every probe without it must match all three.
# Never add `only` to a probe to make a failure disappear — the divergence is the
# finding, and suppressing it destroys the point of the harness.
#
# Each case runs in its own working directory containing `input.txt`
# (three lines: L1, L2, L3) so getline-from-file probes have something to read.
#
# One trailing blank line is stripped from each section — the blank line between
# cases is layout, not data. A case that must end in a blank line writes two.

#=== printf_conversions
#--- prog
BEGIN {
  printf "%c|%c|\n", 65, "hello"
  printf "%i %d %d\n", 3.9, -3.9, "12abc"
  printf "%*d|%-*d|%.*f|\n", 5, 42, 5, 42, 2, 3.14159
  printf "%5.2s|%-5s|%05d|%+d|% d|\n", "abcdef", "ab", 42, 42, 42
  printf "%o %x %X %e %E %g %G\n", 8, 255, 255, 1234.5, 1234.5, 0.0001234, 123456789
  printf "%%|%d|\n", 2147483648
  printf "%.30g\n", 0.1
}

#=== printf_uninitialized
# An uninitialized value is a number for %c, and every awk emits NUL for it.
#--- prog
BEGIN { printf "%s|%d|%c|%f|\n", x, x, x, x }

#=== printf_unsigned_conversions_of_negative
# Reference disagreement, recorded rather than hidden: gawk converts a negative
# argument to %x / %o / %X as a 64-bit unsigned value; one-true-awk and mawk
# both print 0. awkrs follows gawk.
#--- only gawk
#--- prog
BEGIN { printf "%x %o %X\n", -3, -3, -3 }

#=== printf_c_empty_string
# Three-way disagreement, recorded rather than hidden: POSIX says %c outputs the
# first character of a string value, and an empty string has none. one-true-awk
# emits nothing (and awkrs follows it); gawk and mawk emit a stray NUL byte.
# Checked against the reference that agrees with POSIX.
#--- only bsd
#--- prog
BEGIN { printf "[%c]\n", "" }

#=== ofmt_convfmt
#--- prog
BEGIN {
  OFMT = "%.2f"; x = 3.14159; print x; print x ""
  CONVFMT = "%.2f"; print x ""; print length(x "")
  print 100000, 1e17, 2^53, 2147483647
}

#=== integral_values_bypass_ofmt
#--- prog
BEGIN { OFMT = "%.2f"; CONVFMT = "%.2f"; print 5, 5 "", 5.0, -0 }

#=== strnum_comparison
#--- prog
{ print ($1 == 10), ($1 < 9), ($1 == "10.0"), ($1 "" == "10") }
#--- in
10
 10
10.0

#=== relational_field_vs_field
# Regression pin: `<` `<=` `>` `>=` between two fields must honour the strnum
# rule — string compare when either side is not numeric-looking, numeric compare
# when both are. A peephole that treated the relational ops as numeric consumers
# used to coerce the right-hand field to a number first, so "a" < "b" answered 0.
#--- prog
{ print ($1 < $2), ($2 < $1), ($1 > $2), ($2 > $1), ($1 <= $2), ($1 >= $2), ($1 == $2) }
#--- in
a b
2 10
10 9
b a


x

#=== uninitialized_semantics
#--- prog
BEGIN { print "[" x "]", x + 0, length(x), (x == 0), (x == "") }

#=== string_to_number
#--- prog
BEGIN { print "010" + 0, " 12 " + 0, "1e3" + 0, "+5" + 0, ".5" + 0, "5." + 0 }

#=== string_to_number_hex_literal
# Reference disagreement, recorded rather than hidden: POSIX string-to-number
# conversion has no hex form, so `"0x10" + 0` is 0. gawk and mawk agree on 0;
# one-true-awk's strtod accepts the 0x prefix and yields 16. awkrs follows POSIX.
#--- only gawk,mawk
#--- prog
BEGIN { print "0x10" + 0 }

#=== fs_default_whitespace
#--- prog
{ print NF "|" $1 "|" $2 "|" }
#--- in
  a	 b

#=== fs_single_char_is_literal
#--- prog
BEGIN { FS = "." } { print NF "|" $1 "|" $2 "|" $3 "|" }
#--- in
a.b.c

#=== fs_regex
#--- prog
BEGIN { FS = "[0-9]+" } { print NF "|" $1 "|" $2 "|" $3 "|" }
#--- in
a12b345c

#=== fs_change_takes_effect_next_record
#--- prog
NR == 1 { FS = ":" } { print NR, NF, $1 }
#--- in
a:b
c:d

#=== ofs_rebuild_on_field_assign
#--- prog
BEGIN { OFS = "-" } { print; $1 = $1; print; print $1, $2 }
#--- in
a b c

#=== ors
#--- prog
BEGIN { ORS = "|" } { print } END { printf "\n" }
#--- in
a
b

#=== rs_single_char
#--- prog
BEGIN { RS = ":" } { print NR "[" $0 "]" } END { print "NR=" NR }
#--- in
a:b:c

#=== rs_paragraph_mode_default_fs
#--- prog
BEGIN { RS = "" } { print NR "[" $0 "]", NF } END { print "NR=" NR }
#--- in
a b
c


d

#=== rs_paragraph_mode_newline_is_field_sep
# gawk and one-true-awk make <newline> an extra separator for a single-char FS
# (gawk rewrites FS to `[<fs>\n]`); mawk does not implement that rule.
#--- only gawk,bsd
#--- prog
BEGIN { RS = ""; FS = ":" } { print NF "|" $1 "|" $2 "|" $3 "|" $4 "|" }
#--- in
a:b
c:d

#=== rs_paragraph_mode_regex_fs_keeps_newline
# The newline rule stops at single-char FS: with a regex FS every reference awk
# leaves the embedded newline inside $2.
#--- prog
BEGIN { RS = ""; FS = "[0-9]+" } { print NF "|" $1 "|" $2 "|" $3 "|" }
#--- in
a12b
c345d

#=== nf_assignment_truncates_and_extends
#--- prog
BEGIN { OFS = "-" } { NF = 2; print NF, "[" $0 "]" }
#--- in
a b c d

#=== field_assignment_beyond_nf
#--- prog
{ $6 = "x"; print NF, "[" $0 "]" }
#--- in
a b c

#=== dollar0_assignment_resplits
#--- prog
{ $0 = "p q r"; print NF, $2 }
#--- in
a

#=== substr_out_of_range
#--- prog
BEGIN {
  print "[" substr("hello", 0) "]"
  print "[" substr("hello", 2, -1) "]"
  print "[" substr("hello", 1.5, 2.4) "]"
  print "[" substr("hello", 10) "]"
}

#=== substr_negative_start_and_huge_length
# Reference disagreement, recorded rather than hidden: POSIX clamps the
# character range to the intersection of [m, m+n) with [1, length]. gawk and
# one-true-awk both do that (`substr("hello",-1,3)` is "hel", and a length of
# 1e300 simply runs to the end); mawk counts differently and overflows the huge
# length to an empty result. awkrs follows gawk / one-true-awk.
#--- only gawk,bsd
#--- prog
BEGIN { printf "[%s][%s]\n", substr("hello", -1, 3), substr("hello", 2, 1e300) }

#=== index_and_length
#--- prog
BEGIN { print index("abc", ""), index("", "a"), index("abc", "c"), length("abc"), length() }

#=== split_forms
#--- prog
BEGIN {
  print split("a:b:c", A, ":"), A[1], A[3]
  print split("  a  b  ", B), "[" B[1] "]", "[" B[2] "]"
  print split("", C, ":")
  print split(":a:", D, ":"), "[" D[1] "]", "[" D[2] "]", "[" D[3] "]"
  print split("a1b22c", E, /[0-9]+/), E[1], E[2], E[3]
}

#=== gsub_ampersand
#--- prog
BEGIN {
  s = "hello"; print gsub(/l/, "[&]", s), s
  t = "hello"; print gsub(/l/, "[\\&]", t), t
  u = "abc";   print gsub(/x*/, "-", u), u
  v = "banana"; print gsub(/ana/, "X", v), v
}

#=== sub_on_field_rebuilds_record
#--- prog
{ sub(/o/, "X", $2); print; print NF }
#--- in
foo bar boo

#=== match_rstart_rlength
#--- prog
BEGIN {
  print match("hello world", /o w/), RSTART, RLENGTH
  print match("hello", /xyz/), RSTART, RLENGTH
  print match("hello", //), RSTART, RLENGTH
}

#=== arrays_in_delete_subsep
#--- prog
BEGIN {
  A[1] = 1
  print (1 in A), ("1" in A), (2 in A), length(A)
  if (B["x"] == "") print "reference created it:", length(B), ("x" in B)
  C[1, 2] = "v"
  print ((1, 2) in C), length(C)
  delete C[1, 2]
  print length(C)
}

#=== typeof_unassigned_vs_untyped
# gawk separates an array element that does not exist ("untyped") from one a
# bare read auto-created but never assigned ("unassigned"). `typeof` itself does
# not create the element. Not a POSIX builtin, so gawk is the only reference.
#--- only gawk
#--- prog
BEGIN {
  print typeof(a["k"])
  y = a["k"]
  print typeof(a["k"]), typeof(a["never"])
  a["n"] = 1; a["s"] = ""
  print typeof(a["n"]), typeof(a["s"]), typeof(a)
}

#=== array_key_uses_convfmt
#--- prog
BEGIN { CONVFMT = "%.2f"; A[1.5] = 1; for (k in A) print k; B[2] = 1; for (k in B) print k }

#=== getline_from_file
#--- prog
BEGIN {
  while ((getline line < "input.txt") > 0) n++
  print n, NR, FNR
  print (getline line < "input.txt")
  close("input.txt")
  print (getline line < "input.txt"), line
}

#=== getline_dollar0_from_file
#--- prog
BEGIN { print (getline < "input.txt"), NF, "[" $0 "]", NR, FNR }

#=== getline_missing_file_returns_minus_one
#--- prog
BEGIN { print (getline x < "/nonexistent/awkrs-parity-probe") }

#=== getline_plain_updates_nr
#--- prog
NR == 1 { print "r=" getline, "NR=" NR, "NF=" NF, "[" $0 "]" }
{ print "body:" NR ":" $0 }
#--- in
a b
c d
e f

#=== getline_at_eof_returns_zero
#--- prog
END { print "eof=" getline, "NR=" NR }
#--- in
a
b

#=== getline_from_command
#--- prog
BEGIN {
  "echo hi there" | getline
  print "[" $0 "]", NF, NR
  "echo 7" | getline v
  print v, NR, NF
}

#=== exit_bare_in_end_preserves_status
#--- prog
BEGIN { print "b"; exit 3 }
END { print "e"; exit }

#=== exit_expression_in_end_overrides
#--- prog
BEGIN { exit 3 }
END { exit 5 }

#=== exit_from_main_rule
#--- prog
{ exit 4 }
END { print "e", NR }
#--- in
a
b

#=== range_and_regex_patterns
#--- prog
/a/, /c/ { print "R:" $0 }
#--- in
a
b
c
d
a

#=== user_function_locals_and_arrays
#--- prog
function f(a, b) { b = 5; return a + b }
function g(arr) { arr["k"] = "v"; return length(arr) }
BEGIN { b = 1; print f(1), b; print g(A), A["k"] }

#=== assignment_operators
#--- prog
BEGIN { x = 10; x += 1; x -= 2; x *= 3; x /= 2; x %= 7; x ^= 2; print x }

#=== modulo_and_exponent
#--- prog
BEGIN { print 7 % 3, -7 % 3, 7 % -3, 7.5 % 2, 2 ^ 3 ^ 2, -2 ^ 2 }

#=== increment_on_field
#--- prog
{ $1++; print; print NF }
#--- in
5 b

#=== printf_star_width_and_precision
#--- prog
BEGIN {
  printf "[%*d][%-*d][%.*f][%.*s]\n", 5, 42, 5, 42, 2, 3.14159, 3, "abcdef"
  printf "[%*.*f]\n", 10, 3, 3.14159
  printf "[%*d]\n", -6, 42
}

#=== printf_star_negative_precision_is_omitted
# ISO C: "A negative precision argument is taken as if the precision were
# omitted." `%.*f` with -2 is therefore the default six places, not zero.
# `%.*s` is left to its own probe — mawk loops on it.
#--- prog
BEGIN { printf "[%.*f][%.*d]\n", -2, 3.14159, -2, 42 }

#=== printf_star_negative_precision_string
# Same rule for `%s`, but mawk mishandles a negative `*` precision there and
# emits megabytes of garbage, so this half is checked against the two
# references that implement the C rule.
#--- only gawk,bsd
#--- prog
BEGIN { printf "[%.*s]\n", -2, "abcdef" }

#=== printf_c_numeric_vs_string
# `%c` prints the first character of a string and the character with the given
# code for a number. A *numeric string* — here `$1` read from input — counts as
# numeric in every reference, so `65` prints `A`, while the string literal "65"
# prints `6`.
#--- prog
BEGIN { printf "[%c][%c][%c]\n", 65, "65", "A" }
{ printf "[%c][%c]\n", $1, $2 }
#--- in
65 A

#=== strnum_only_from_input_not_from_builtins
# POSIX numeric strings come from input (fields, getline, split, ARGV/ENVIRON),
# never from a computed string. `substr("065",1,2)` is the string "06", so
# comparing it to 6 is a *string* compare and answers 0.
#--- prog
BEGIN { print (substr("065", 1, 2) == 6), (sprintf("%s", "06") == 6), (toupper("06") == 6), (tolower("06") == 6) }
{ print ($1 == 6), ($1 "" == 6) }
#--- in
06

#=== sub_no_match_leaves_target_untouched
# A `sub`/`gsub` that matches nothing must not rewrite the target: an
# uninitialized variable stays uninitialized (so `z == 0` is still true) and a
# number stays a number.
#--- prog
BEGIN {
  print sub(/x/, "y", z), (z == 0), (z == "")
  x = 1; print gsub(/q/, "r", x), (x == 1), (x == "1")
}

#=== bare_return_yields_uninitialized
# `return` with no expression yields the uninitialized value, which compares
# equal to both 0 and "".
#--- prog
function f() { return }
function g() { }
BEGIN { print (f() == 0), (f() == ""), (g() == 0), (g() == "") }

#=== empty_record_has_zero_fields
# An empty record has NF == 0 under every FS, not one empty field.
#--- prog
BEGIN { FS = ":" } { print NR, NF, "[" $1 "]" }
#--- in
a:b


#=== empty_record_zero_fields_regex_fs
#--- prog
BEGIN { FS = "[0-9]+" } { print NR, NF } END { print "NR=" NR }
#--- in

a1b

#=== dollar0_assigned_empty_has_zero_fields
#--- prog
BEGIN { FS = ":" } { $0 = ""; print NF, "[" $0 "]" }
#--- in
a:b

#=== empty_statement_as_control_flow_body
# POSIX grammar: `;` alone is a statement, so every control-flow header accepts
# it as an empty body.
#--- prog
BEGIN {
  if (1) ; print "A"
  for (i = 0; i < 2; i++) ; print i
  while (0) ; print "B"
  if (0) ; else print "C"
}

#=== split_regex_literal_is_never_an_fs_shorthand
# `split(s, a, / /)` splits on one literal space (7 fields here), unlike
# `split(s, a, " ")` which is the whitespace-run rule (2 fields). `/./` is the
# any-character regex, unlike the single-character literal ".". An *empty*
# separator splits into characters either way.
#--- prog
BEGIN {
  print split("  a  b  ", A, " "), "[" A[1] "]"
  print split("  a  b  ", B, / /), "[" B[1] "]"
  print split("a.b", C, "."), "[" C[1] "]"
  print split("a.b", D, /./), "[" D[1] "]"
  print split("abc", E, //), E[1], E[3]
}

#=== split_regex_from_a_variable
# A separator held in a *variable* is a dynamic regex string, so the FS
# shorthands apply to it exactly as they do to a literal string.
#--- prog
BEGIN {
  fs = "[0-9]+"; print split("a1b22c", A, fs), A[1], A[2], A[3]
  one = "."; print split("a.b", B, one), "[" B[1] "]"
}

#=== dynamic_regex_from_variable
#--- prog
BEGIN {
  r = "^a"; print ("abc" ~ r), ("bac" ~ r)
  s = "[0-9]+"; print match("ab123", s), RSTART, RLENGTH
  d = "a.c"; print ("abc" ~ d), ("a.c" ~ d)
  e = "\\."; print ("a.c" ~ e), ("abc" ~ e)
}

#=== subsep_multidimensional_in_and_convfmt
# Each subscript of a multidimensional key is converted the same way a single
# subscript is: integral values exactly, everything else through CONVFMT.
#--- prog
BEGIN {
  CONVFMT = "%.2f"
  A[1.234, 2] = 1
  for (k in A) print k
  print ((1.234, 2) in A), ((1, 2) in A)
  SUBSEP = "-"
  B[1, 2] = "v"; print ((1, 2) in B), ("1-2" in B), length(B)
  delete B[1, 2]; print length(B)
}

#=== printf_zero_precision_d_of_a_zero_value
# POSIX (and ISO C) for the `d` conversion: "The result of converting a zero
# value with a precision of 0 shall be no characters." mawk, one-true-awk, the
# C library's own printf and awkrs all print nothing. **gawk deviates**, but
# only when the operand is a non-integral double that truncates to zero:
# `printf "%.0d", 0` is empty in gawk too, while `printf "%.0d", 1e-3` prints
# `0`. The seeded generator reaches this shape through `%.*d` with a fractional
# operand, so the disagreement is pinned here once, against the references that
# implement the standard, rather than rediscovered on every gawk run.
#--- prog
BEGIN {
  printf "[%.0d][%.0d][%.0d]\n", 0, 1e-3, -0.4
  printf "[%.*d][%.*d][%.*d]\n", 0, 0, 0, 1e-3, 0, -0.4
  printf "[%.0d][%.*d]\n", 5, 0, 5
}
#--- only mawk,bsd

#=== single_subscript_convfmt_is_the_same_key_everywhere
# Every operation that takes a subscript must convert it the *same* way the
# store did, or `a[x] = 1` and `x in a` name different entries. Only the store
# and the plain read were checked before: `in`, `delete`, `a[x] += 1`, `a[x]++`
# and `typeof(a[x])` each converted the key their own way, and the existing
# coverage could not see it — every probed `in`/`delete` used either an
# integral subscript (which bypasses CONVFMT and so round-trips whatever the
# conversion is) or the *multidimensional* form, where the SUBSEP join has
# already turned the key into a string before the op ever sees it. A
# non-integral single subscript is the one shape that exposes the difference.
#--- prog
BEGIN {
  CONVFMT = "%.2f"
  x = 1.23456
  A[x] = 5
  print (x in A), ("1.23" in A), ("1.23456" in A)
  A[x] += 1
  A[x]++
  print length(A), A[x], A["1.23"]
  print typeof(A[x])
  delete A[x]
  print length(A), (x in A)
}
#--- only gawk

#=== single_subscript_convfmt_is_the_same_key_everywhere_portable
# The same invariant without `typeof`, so mawk and one-true-awk run it too.
#--- prog
BEGIN {
  CONVFMT = "%.3g"
  x = 2 / 3
  A[x] = 1
  print (x in A), length(A)
  A[x] += 10
  A[x]--
  print length(A), A[x]
  for (k in A) print "[" k "]"
  delete A[x]
  print length(A), (x in A)
}

#=== computed_subscript_round_trips_under_every_convfmt
# The subscript is a *computed* double whose exact decimal expansion is longer
# than any CONVFMT rendering of it, so a key built at full precision can never
# equal the stored one.
#--- prog
BEGIN {
  split("%.2f %.6g %.17g %.3e", F, " ")
  for (i = 1; i <= 4; i++) {
    CONVFMT = F[i]
    delete A
    v = 0.1 + 0.2
    A[v] = 1
    A[v] += 1
    print F[i], (v in A), length(A), A[v]
  }
}

#=== delete_whole_array
#--- prog
function clear(a) { delete a; return length(a) }
BEGIN {
  A[1] = 1; A[2] = 2
  delete A
  print length(A), (1 in A)
  B[1] = 1; print clear(B), length(B)
  delete C; print length(C)
}

#=== rs_regex_and_multichar
#--- prog
BEGIN { RS = "[0-9]+" } { print NR "[" $0 "]" } END { print "NR=" NR }
#--- in
a1b22c

#=== rs_multichar_literal
#--- prog
BEGIN { RS = "ab" } { print NR "[" $0 "]" } END { print "NR=" NR }
#--- in
XabYabZ

#=== fs_tab_versus_default_leading_blanks
#--- prog
BEGIN { FS = "\t" } { print NR, NF, "[" $1 "]", "[" $2 "]" }
#--- in
	a	b	

#=== fs_default_strips_leading_and_trailing_blanks
#--- prog
{ print NF, "[" $1 "]", "[" $NF "]" }
#--- in
   a	 b   

#=== fs_single_space_class_keeps_empty_fields
# `FS = "[ ]"` is a one-character *regex*, not the whitespace-run default, so
# leading and trailing blanks produce empty fields.
#--- prog
BEGIN { FS = "[ ]" } { print NF, "[" $1 "]", "[" $NF "]" }
#--- in
 a b 

#=== getline_all_forms_return_values
#--- prog
BEGIN {
  print "1:" (getline < "input.txt"), NF, "[" $0 "]", NR, FNR
  print "2:" (getline line < "input.txt"), line
  print "3:" (getline x < "/nonexistent/awkrs-parity-probe")
  print "4:" ("echo p q" | getline), NF, "[" $0 "]", NR
  print "5:" ("echo z" | getline v), v, NR
  close("echo p q"); close("echo z"); close("input.txt")
}
NR == 1 { print "6:" getline, "NR=" NR, "[" $0 "]" }
END { print "7:" getline, "NR=" NR }
#--- in
r1
r2

#=== close_return_values
# `close()` of a never-opened name is negative in every reference; the exit
# status of a closed pipe is reported by gawk and mawk (one-true-awk returns 0),
# which its own probe covers.
#--- prog
BEGIN {
  print (close("never-opened-by-this-probe") < 0)
  getline x < "input.txt"
  print close("input.txt")
  print (close("input.txt") < 0)
}

#=== close_pipe_reports_command_status
# gawk and mawk return the command's exit status from `close()` on a pipe;
# one-true-awk returns 0. Recorded rather than hidden.
#--- only gawk,mawk
#--- prog
BEGIN { "exit 3" | getline; print close("exit 3") }

#=== print_redirect_overwrite_versus_append
#--- prog
BEGIN {
  print "a" > "out"; print "b" > "out"; close("out")
  while ((getline l < "out") > 0) print "W:" l
  close("out")
  print "c" >> "out"; close("out")
  while ((getline l < "out") > 0) print "A:" l
}

#=== system_flushes_pending_output_first
#--- prog
BEGIN {
  print "before"
  system("echo middle")
  printf "no-newline"
  system("")
  print "after"
  print system("exit 7")
}

#=== srand_returns_previous_seed
#--- prog
BEGIN { srand(1); print srand(2), srand(3) }

#=== nf_assignment_rebuilds_record
#--- prog
BEGIN { OFS = "-" }
{
  NF = 2; print; print NF
  NF = 4; print "[" $0 "]", NF
  $0 = "p q r"; print NF, $2
}
#--- in
a b c d

#=== ofmt_applies_to_print_convfmt_to_concatenation
#--- prog
BEGIN {
  OFMT = "%.2f"; CONVFMT = "%.4f"
  x = 3.14159
  print x
  print x ""
  printf "%s\n", x
  print length(x "")
  print 100000, 2147483647
}

#=== break_outside_a_loop_is_rejected
# All three references refuse the program outright and run nothing: gawk exits 1,
# mawk and one-true-awk exit 2. awkrs follows the two-reference majority (and its
# own `return` outside function convention) with exit 2, so gawk is excluded on
# the *status* alone — stdout is empty in all four. Before this was checked, the
# compiler left `break`'s placeholder `Op::Jump(0)` unpatched when no loop
# enclosed it and the program looped on instruction 0 forever.
#--- only mawk,bsd
#--- prog
BEGIN { print "never"; break }

#=== continue_outside_a_loop_is_rejected
# Same rejection, same status split, same former infinite loop.
#--- only mawk,bsd
#--- prog
BEGIN { print "never"; continue }

#=== break_outside_a_loop_in_a_function_is_rejected
#--- only mawk,bsd
#--- prog
function f() { break }
BEGIN { f() }

#=== break_and_continue_in_every_loop_form
# `for`, `while`, `do-while` and `for-in`, each with both jumps, plus the nested
# and in-function forms. `for (k in a)` prints only order-independent counters
# because the iteration order is unspecified.
#--- prog
function f(n,   i, s) { for (i = 0; i < n; i++) { if (i == 2) continue; s = s i } return s }
BEGIN {
  for (i = 0; i < 5; i++) { if (i == 3) break; print "for", i }
  i = 0; while (i < 5) { i++; if (i == 3) continue; print "while", i }
  i = 0; do { i++; if (i == 4) break; print "do", i } while (i < 5)
  for (j = 0; j < 3; j++) a[j] = j
  c = 0; for (k in a) { c++; if (k == 1) continue; c += 10 }
  print "forin", c
  for (p = 0; p < 3; p++) { for (q = 0; q < 3; q++) { if (q == 1) break; print "nest", p, q } }
  print "fn", f(5)
}

#=== break_and_continue_target_the_switch_then_the_loop
# gawk only: mawk and one-true-awk have no `switch`. `break` leaves the switch,
# `continue` skips to the enclosing loop's next iteration.
#--- only gawk
#--- prog
BEGIN {
  for (i = 0; i < 3; i++) { switch (i) { case 1: break }; print "b", i }
  for (i = 0; i < 3; i++) { switch (i) { case 1: continue }; print "c", i }
}

#=== exit_inside_a_function_still_runs_end
# `exit` raised inside a user function has to unwind to the driver as an ordinary
# exit, not as a fatal error: all three references print `end` and exit 3. awkrs
# used to transport it as `Error::Exit` out of the call, which skipped `END`.
#--- prog
function g() { exit 3 }
function f() { g() }
BEGIN { f(); print "never" }
END { print "end" }

#=== exit_inside_a_function_from_a_main_rule_still_runs_end
#--- prog
function f() { exit 4 }
{ f(); print "never" }
END { print "end" }
#--- in
one

#=== exit_inside_a_function_assigned_from_a_call_still_runs_end
#--- prog
function f(n) { exit 5; return 1 }
BEGIN { x = f(1); print "never", x }
END { print "end" }

#=== next_and_nextfile_from_inside_a_loop
#--- prog
NR == 2 { for (i = 0; i < 3; i++) if (i == 1) next }
{ print NR, "[" $0 "]" }
END { print "END", NR }
#--- in
a
b
c

#=== assigned_field_is_not_a_numeric_string
# POSIX: only input-derived values are numeric strings. A field assigned a string
# literal or any computed string compares as text, so `$1 = "42"` makes `$1 < 7`
# true ("42" < "7"). Assigning a number or another field keeps it numeric.
# gawk, mawk and one-true-awk all agree on every line here.
#--- prog
{
  $1 = "42"; print ($1 < 7), ($1 == 42)
  $2 = 42;   print ($2 < 7)
  $3 = $2;   print ($3 < 7)
  $4 = "4" "2"; print ($4 < 7)
  $5 = substr("42", 1); print ($5 < 7)
}
#--- in
9 9 9 9 9

#=== assigned_record_is_not_a_numeric_string
# Same rule for `$0`, and re-splitting an assigned record still yields numeric
# string *fields* — only `$0` itself loses the status.
#--- prog
{
  $0 = "42"; print ($0 < 7), ($0 == 42), ($1 < 7)
  $0 = "06"; print ($0 == 6), ($1 == 6)
  $0 = " 42 "; print ($0 < 7)
}
#--- in
9

#=== rewritten_record_is_not_a_numeric_string
# `gsub` rewriting `$0` produces a computed string even when the text is
# unchanged, so the later relational compares as text.
#--- prog
{ gsub(/2/, "2"); print ($0 < 7) }
#--- in
42

#=== record_assignment_keeps_numeric_string_from_a_numeric_string_source
# The other half of the rule: assigning a value that *is* a numeric string keeps
# it one, so these must stay numeric comparisons.
#--- prog
{
  print ($0 < 7)
  $0 = $0; print ($0 < 7)
  $0 = $1; print ($0 < 7)
  sub(/x/, "y"); print ($0 < 7)
}
#--- in
42

#=== typeof_dollar0_before_any_record
# gawk reports `$0` as "unassigned" until the record is first given a value, and
# a bare *read* of `$0` does not count as giving it one. `typeof` is a gawk
# extension; mawk and one-true-awk have no such builtin.
#--- only gawk
#--- prog
BEGIN {
  print typeof($0)
  x = $0 ""
  print typeof($0), length($0)
  if ($0 ~ /x/) q = 1
  print typeof($0)
  $0 = "abc"
  print typeof($0)
}

#=== convfmt_reaches_every_string_builtin
# POSIX has one rule for turning a number into a string outside `print`: it
# renders through CONVFMT. awkrs honoured that in concatenation, comparison and
# array subscripts but not in the string builtins, which read the number at full
# f64 precision — so `length(1.23456)` was 7 under `CONVFMT="%.2f"` where gawk,
# mawk and one-true-awk all say 4.
#--- prog
BEGIN {
  CONVFMT = "%.2f"
  x = 1.23456
  print length(x)
  print "[" substr(x, 3) "]", "[" substr(x, 1, 99) "]"
  print index(x, "456"), index(x, "23"), index("a1.23b", x)
  print toupper(x), tolower(x)
  n = split(x, A, "z"); print n, "[" A[1] "]"
}

#=== convfmt_reaches_every_dynamic_regex_operand
# A dynamic regex is the string value of its operand, so a number becomes a
# pattern through CONVFMT too. Only the subject side of `~` / `!~` converted
# that way, which left `"a1.23b" ~ x` false while `"a1.23b" == x` — the same
# coercion one operator apart — was true.
#--- prog
BEGIN {
  CONVFMT = "%.2f"
  x = 1.23456
  print ("a1.23b" ~ x), ("a1.23b" !~ x)
  print match("a1.23b", x), RSTART, RLENGTH
  print split("a1.23b", A, x)
  s = "a1.23b"; print sub(x, "Z", s), s
  t = "a1.23b"; print gsub(x, "Z", t), t
}

#=== convfmt_reaches_sub_target_and_replacement
# `sub`/`gsub` read the subject as a string and write a string back, so a numeric
# target is rewritten from its CONVFMT rendering and can never leave the dropped
# digits behind. The replacement text converts the same way.
#--- prog
BEGIN {
  CONVFMT = "%.2f"
  x = 1.23456
  a = x; gsub(/3/, "9", a); print a
  b = x; sub(/2/, "9", b); print b
  A[1] = x; gsub(/3/, "9", A[1]); print A[1]
  s = "aXb"; sub(/X/, x, s); print s
  t = "aXb"; gsub(/X/, x, t); print t
}

#=== convfmt_coercion_is_read_at_each_use
# The conversion happens at the point of use, never cached at assignment:
# changing CONVFMT between two reads of the same variable changes both answers.
# A "convert once when stored" implementation passes every single-format case
# and still fails this one.
#--- prog
BEGIN {
  CONVFMT = "%.2f"; x = 1.23456
  a = length(x)
  CONVFMT = "%.4f"
  b = length(x)
  print a, b
}

#=== convfmt_leaves_integral_numbers_and_input_text_alone
# The guard on the rule above. An integral value bypasses CONVFMT entirely, and
# a field is a string carrying the original input text — so `$1` of the record
# `1.23456` stays seven characters under "%.2f" in every reference.
#--- prog
{
  CONVFMT = "%.2f"
  y = 100000
  print length(y), toupper(y), index(y, "00000")
  print length($1), toupper($1), substr($1, 3)
}
#--- in
1.23456


#=== undefined_escape_in_a_string_literal
# POSIX leaves `\$` in a string literal undefined, and the references split two
# to one: gawk warns and treats it as a plain `$` (so the regex still anchors at
# end of string) and one-true-awk does the same silently, while mawk keeps the
# backslash and matches a literal `$` instead — answering `0 0 -1` here. awkrs
# follows gawk and one-true-awk. Pinned rather than generated: the dynamic-regex
# template used to emit this shape by accident on every draw of its `c$` entry,
# which reported this one known mawk deviation over and over instead of finding
# new gaps.
#--- only gawk,bsd
#--- prog
BEGIN {
  r = "c\$"
  print match("a:b:c", r), RSTART, RLENGTH
  print ("a:b:c" ~ r), ("c$" ~ r)
}
