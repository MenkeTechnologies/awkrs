# Curated differential probes — read by scripts/fuzz_parity.sh.
#
# Format:
#   #=== <name>                 starts a case
#   #--- prog                   program text follows, up to the next directive
#   #--- in                     stdin text follows (optional)
#   #--- only <ref>[,<ref>]     restrict this probe to the named reference awks
#
# `#--- only` is NOT a failure allowlist. It exists for the handful of probes
# where the reference implementations disagree with *each other*, so there is no
# single ground truth to compare against; the directive records which references
# define the behavior awkrs targets. Every probe without it must match all three.
# Never add `only` to a probe to make a failure disappear — the divergence is the
# finding, and suppressing it destroys the point of the harness.
#
# Each case runs in its own working directory containing `input.txt`
# (three lines: L1, L2, L3) so getline-from-file probes have something to read.
#
# One trailing blank line is stripped from each section — the blank line between
# cases is layout, not data. A case that must end in a blank line writes two.

#=== printf_conversions
#--- prog
BEGIN {
  printf "%c|%c|\n", 65, "hello"
  printf "%i %d %d\n", 3.9, -3.9, "12abc"
  printf "%*d|%-*d|%.*f|\n", 5, 42, 5, 42, 2, 3.14159
  printf "%5.2s|%-5s|%05d|%+d|% d|\n", "abcdef", "ab", 42, 42, 42
  printf "%o %x %X %e %E %g %G\n", 8, 255, 255, 1234.5, 1234.5, 0.0001234, 123456789
  printf "%%|%d|\n", 2147483648
  printf "%.30g\n", 0.1
}

#=== printf_uninitialized
# An uninitialized value is a number for %c, and every awk emits NUL for it.
#--- prog
BEGIN { printf "%s|%d|%c|%f|\n", x, x, x, x }

#=== printf_unsigned_conversions_of_negative
# Reference disagreement, recorded rather than hidden: gawk converts a negative
# argument to %x / %o / %X as a 64-bit unsigned value; one-true-awk and mawk
# both print 0. awkrs follows gawk.
#--- only gawk
#--- prog
BEGIN { printf "%x %o %X\n", -3, -3, -3 }

#=== printf_c_empty_string
# Three-way disagreement, recorded rather than hidden: POSIX says %c outputs the
# first character of a string value, and an empty string has none. one-true-awk
# emits nothing (and awkrs follows it); gawk and mawk emit a stray NUL byte.
# Checked against the reference that agrees with POSIX.
#--- only bsd
#--- prog
BEGIN { printf "[%c]\n", "" }

#=== ofmt_convfmt
#--- prog
BEGIN {
  OFMT = "%.2f"; x = 3.14159; print x; print x ""
  CONVFMT = "%.2f"; print x ""; print length(x "")
  print 100000, 1e17, 2^53, 2147483647
}

#=== integral_values_bypass_ofmt
#--- prog
BEGIN { OFMT = "%.2f"; CONVFMT = "%.2f"; print 5, 5 "", 5.0, -0 }

#=== strnum_comparison
#--- prog
{ print ($1 == 10), ($1 < 9), ($1 == "10.0"), ($1 "" == "10") }
#--- in
10
 10
10.0

#=== relational_field_vs_field
# Regression pin: `<` `<=` `>` `>=` between two fields must honour the strnum
# rule — string compare when either side is not numeric-looking, numeric compare
# when both are. A peephole that treated the relational ops as numeric consumers
# used to coerce the right-hand field to a number first, so "a" < "b" answered 0.
#--- prog
{ print ($1 < $2), ($2 < $1), ($1 > $2), ($2 > $1), ($1 <= $2), ($1 >= $2), ($1 == $2) }
#--- in
a b
2 10
10 9
b a


x

#=== uninitialized_semantics
#--- prog
BEGIN { print "[" x "]", x + 0, length(x), (x == 0), (x == "") }

#=== string_to_number
#--- prog
BEGIN { print "010" + 0, " 12 " + 0, "1e3" + 0, "+5" + 0, ".5" + 0, "5." + 0 }

#=== string_to_number_hex_literal
# Reference disagreement, recorded rather than hidden: POSIX string-to-number
# conversion has no hex form, so `"0x10" + 0` is 0. gawk and mawk agree on 0;
# one-true-awk's strtod accepts the 0x prefix and yields 16. awkrs follows POSIX.
#--- only gawk,mawk
#--- prog
BEGIN { print "0x10" + 0 }

#=== fs_default_whitespace
#--- prog
{ print NF "|" $1 "|" $2 "|" }
#--- in
  a	 b

#=== fs_single_char_is_literal
#--- prog
BEGIN { FS = "." } { print NF "|" $1 "|" $2 "|" $3 "|" }
#--- in
a.b.c

#=== fs_regex
#--- prog
BEGIN { FS = "[0-9]+" } { print NF "|" $1 "|" $2 "|" $3 "|" }
#--- in
a12b345c

#=== fs_change_takes_effect_next_record
#--- prog
NR == 1 { FS = ":" } { print NR, NF, $1 }
#--- in
a:b
c:d

#=== ofs_rebuild_on_field_assign
#--- prog
BEGIN { OFS = "-" } { print; $1 = $1; print; print $1, $2 }
#--- in
a b c

#=== ors
#--- prog
BEGIN { ORS = "|" } { print } END { printf "\n" }
#--- in
a
b

#=== rs_single_char
#--- prog
BEGIN { RS = ":" } { print NR "[" $0 "]" } END { print "NR=" NR }
#--- in
a:b:c

#=== rs_paragraph_mode_default_fs
#--- prog
BEGIN { RS = "" } { print NR "[" $0 "]", NF } END { print "NR=" NR }
#--- in
a b
c


d

#=== rs_paragraph_mode_newline_is_field_sep
# gawk and one-true-awk make <newline> an extra separator for a single-char FS
# (gawk rewrites FS to `[<fs>\n]`); mawk does not implement that rule.
#--- only gawk,bsd
#--- prog
BEGIN { RS = ""; FS = ":" } { print NF "|" $1 "|" $2 "|" $3 "|" $4 "|" }
#--- in
a:b
c:d

#=== rs_paragraph_mode_regex_fs_keeps_newline
# The newline rule stops at single-char FS: with a regex FS every reference awk
# leaves the embedded newline inside $2.
#--- prog
BEGIN { RS = ""; FS = "[0-9]+" } { print NF "|" $1 "|" $2 "|" $3 "|" }
#--- in
a12b
c345d

#=== nf_assignment_truncates_and_extends
#--- prog
BEGIN { OFS = "-" } { NF = 2; print NF, "[" $0 "]" }
#--- in
a b c d

#=== field_assignment_beyond_nf
#--- prog
{ $6 = "x"; print NF, "[" $0 "]" }
#--- in
a b c

#=== dollar0_assignment_resplits
#--- prog
{ $0 = "p q r"; print NF, $2 }
#--- in
a

#=== substr_out_of_range
#--- prog
BEGIN {
  print "[" substr("hello", 0) "]"
  print "[" substr("hello", 2, -1) "]"
  print "[" substr("hello", 1.5, 2.4) "]"
  print "[" substr("hello", 10) "]"
}

#=== substr_negative_start_and_huge_length
# Reference disagreement, recorded rather than hidden: POSIX clamps the
# character range to the intersection of [m, m+n) with [1, length]. gawk and
# one-true-awk both do that (`substr("hello",-1,3)` is "hel", and a length of
# 1e300 simply runs to the end); mawk counts differently and overflows the huge
# length to an empty result. awkrs follows gawk / one-true-awk.
#--- only gawk,bsd
#--- prog
BEGIN { printf "[%s][%s]\n", substr("hello", -1, 3), substr("hello", 2, 1e300) }

#=== index_and_length
#--- prog
BEGIN { print index("abc", ""), index("", "a"), index("abc", "c"), length("abc"), length() }

#=== split_forms
#--- prog
BEGIN {
  print split("a:b:c", A, ":"), A[1], A[3]
  print split("  a  b  ", B), "[" B[1] "]", "[" B[2] "]"
  print split("", C, ":")
  print split(":a:", D, ":"), "[" D[1] "]", "[" D[2] "]", "[" D[3] "]"
  print split("a1b22c", E, /[0-9]+/), E[1], E[2], E[3]
}

#=== gsub_ampersand
#--- prog
BEGIN {
  s = "hello"; print gsub(/l/, "[&]", s), s
  t = "hello"; print gsub(/l/, "[\\&]", t), t
  u = "abc";   print gsub(/x*/, "-", u), u
  v = "banana"; print gsub(/ana/, "X", v), v
}

#=== sub_on_field_rebuilds_record
#--- prog
{ sub(/o/, "X", $2); print; print NF }
#--- in
foo bar boo

#=== match_rstart_rlength
#--- prog
BEGIN {
  print match("hello world", /o w/), RSTART, RLENGTH
  print match("hello", /xyz/), RSTART, RLENGTH
  print match("hello", //), RSTART, RLENGTH
}

#=== arrays_in_delete_subsep
#--- prog
BEGIN {
  A[1] = 1
  print (1 in A), ("1" in A), (2 in A), length(A)
  if (B["x"] == "") print "reference created it:", length(B), ("x" in B)
  C[1, 2] = "v"
  print ((1, 2) in C), length(C)
  delete C[1, 2]
  print length(C)
}

#=== typeof_unassigned_vs_untyped
# gawk separates an array element that does not exist ("untyped") from one a
# bare read auto-created but never assigned ("unassigned"). `typeof` itself does
# not create the element. Not a POSIX builtin, so gawk is the only reference.
#--- only gawk
#--- prog
BEGIN {
  print typeof(a["k"])
  y = a["k"]
  print typeof(a["k"]), typeof(a["never"])
  a["n"] = 1; a["s"] = ""
  print typeof(a["n"]), typeof(a["s"]), typeof(a)
}

#=== array_key_uses_convfmt
#--- prog
BEGIN { CONVFMT = "%.2f"; A[1.5] = 1; for (k in A) print k; B[2] = 1; for (k in B) print k }

#=== getline_from_file
#--- prog
BEGIN {
  while ((getline line < "input.txt") > 0) n++
  print n, NR, FNR
  print (getline line < "input.txt")
  close("input.txt")
  print (getline line < "input.txt"), line
}

#=== getline_dollar0_from_file
#--- prog
BEGIN { print (getline < "input.txt"), NF, "[" $0 "]", NR, FNR }

#=== getline_missing_file_returns_minus_one
#--- prog
BEGIN { print (getline x < "/nonexistent/awkrs-parity-probe") }

#=== getline_plain_updates_nr
#--- prog
NR == 1 { print "r=" getline, "NR=" NR, "NF=" NF, "[" $0 "]" }
{ print "body:" NR ":" $0 }
#--- in
a b
c d
e f

#=== getline_at_eof_returns_zero
#--- prog
END { print "eof=" getline, "NR=" NR }
#--- in
a
b

#=== getline_from_command
#--- prog
BEGIN {
  "echo hi there" | getline
  print "[" $0 "]", NF, NR
  "echo 7" | getline v
  print v, NR, NF
}

#=== exit_bare_in_end_preserves_status
#--- prog
BEGIN { print "b"; exit 3 }
END { print "e"; exit }

#=== exit_expression_in_end_overrides
#--- prog
BEGIN { exit 3 }
END { exit 5 }

#=== exit_from_main_rule
#--- prog
{ exit 4 }
END { print "e", NR }
#--- in
a
b

#=== range_and_regex_patterns
#--- prog
/a/, /c/ { print "R:" $0 }
#--- in
a
b
c
d
a

#=== user_function_locals_and_arrays
#--- prog
function f(a, b) { b = 5; return a + b }
function g(arr) { arr["k"] = "v"; return length(arr) }
BEGIN { b = 1; print f(1), b; print g(A), A["k"] }

#=== assignment_operators
#--- prog
BEGIN { x = 10; x += 1; x -= 2; x *= 3; x /= 2; x %= 7; x ^= 2; print x }

#=== modulo_and_exponent
#--- prog
BEGIN { print 7 % 3, -7 % 3, 7 % -3, 7.5 % 2, 2 ^ 3 ^ 2, -2 ^ 2 }

#=== increment_on_field
#--- prog
{ $1++; print; print NF }
#--- in
5 b

#=== printf_star_width_and_precision
#--- prog
BEGIN {
  printf "[%*d][%-*d][%.*f][%.*s]\n", 5, 42, 5, 42, 2, 3.14159, 3, "abcdef"
  printf "[%*.*f]\n", 10, 3, 3.14159
  printf "[%*d]\n", -6, 42
}

#=== printf_star_negative_precision_is_omitted
# ISO C: "A negative precision argument is taken as if the precision were
# omitted." `%.*f` with -2 is therefore the default six places, not zero.
# `%.*s` is left to its own probe — mawk loops on it.
#--- prog
BEGIN { printf "[%.*f][%.*d]\n", -2, 3.14159, -2, 42 }

#=== printf_star_negative_precision_string
# Same rule for `%s`, but mawk mishandles a negative `*` precision there and
# emits megabytes of garbage, so this half is checked against the two
# references that implement the C rule.
#--- only gawk,bsd
#--- prog
BEGIN { printf "[%.*s]\n", -2, "abcdef" }

#=== printf_c_numeric_vs_string
# `%c` prints the first character of a string and the character with the given
# code for a number. A *numeric string* — here `$1` read from input — counts as
# numeric in every reference, so `65` prints `A`, while the string literal "65"
# prints `6`.
#--- prog
BEGIN { printf "[%c][%c][%c]\n", 65, "65", "A" }
{ printf "[%c][%c]\n", $1, $2 }
#--- in
65 A

#=== strnum_only_from_input_not_from_builtins
# POSIX numeric strings come from input (fields, getline, split, ARGV/ENVIRON),
# never from a computed string. `substr("065",1,2)` is the string "06", so
# comparing it to 6 is a *string* compare and answers 0.
#--- prog
BEGIN { print (substr("065", 1, 2) == 6), (sprintf("%s", "06") == 6), (toupper("06") == 6), (tolower("06") == 6) }
{ print ($1 == 6), ($1 "" == 6) }
#--- in
06

#=== sub_no_match_leaves_target_untouched
# A `sub`/`gsub` that matches nothing must not rewrite the target: an
# uninitialized variable stays uninitialized (so `z == 0` is still true) and a
# number stays a number.
#--- prog
BEGIN {
  print sub(/x/, "y", z), (z == 0), (z == "")
  x = 1; print gsub(/q/, "r", x), (x == 1), (x == "1")
}

#=== bare_return_yields_uninitialized
# `return` with no expression yields the uninitialized value, which compares
# equal to both 0 and "".
#--- prog
function f() { return }
function g() { }
BEGIN { print (f() == 0), (f() == ""), (g() == 0), (g() == "") }

#=== empty_record_has_zero_fields
# An empty record has NF == 0 under every FS, not one empty field.
#--- prog
BEGIN { FS = ":" } { print NR, NF, "[" $1 "]" }
#--- in
a:b


#=== empty_record_zero_fields_regex_fs
#--- prog
BEGIN { FS = "[0-9]+" } { print NR, NF } END { print "NR=" NR }
#--- in

a1b

#=== dollar0_assigned_empty_has_zero_fields
#--- prog
BEGIN { FS = ":" } { $0 = ""; print NF, "[" $0 "]" }
#--- in
a:b

#=== empty_statement_as_control_flow_body
# POSIX grammar: `;` alone is a statement, so every control-flow header accepts
# it as an empty body.
#--- prog
BEGIN {
  if (1) ; print "A"
  for (i = 0; i < 2; i++) ; print i
  while (0) ; print "B"
  if (0) ; else print "C"
}

#=== split_regex_literal_is_never_an_fs_shorthand
# `split(s, a, / /)` splits on one literal space (7 fields here), unlike
# `split(s, a, " ")` which is the whitespace-run rule (2 fields). `/./` is the
# any-character regex, unlike the single-character literal ".". An *empty*
# separator splits into characters either way.
#--- prog
BEGIN {
  print split("  a  b  ", A, " "), "[" A[1] "]"
  print split("  a  b  ", B, / /), "[" B[1] "]"
  print split("a.b", C, "."), "[" C[1] "]"
  print split("a.b", D, /./), "[" D[1] "]"
  print split("abc", E, //), E[1], E[3]
}

#=== split_regex_from_a_variable
# A separator held in a *variable* is a dynamic regex string, so the FS
# shorthands apply to it exactly as they do to a literal string.
#--- prog
BEGIN {
  fs = "[0-9]+"; print split("a1b22c", A, fs), A[1], A[2], A[3]
  one = "."; print split("a.b", B, one), "[" B[1] "]"
}

#=== dynamic_regex_from_variable
#--- prog
BEGIN {
  r = "^a"; print ("abc" ~ r), ("bac" ~ r)
  s = "[0-9]+"; print match("ab123", s), RSTART, RLENGTH
  d = "a.c"; print ("abc" ~ d), ("a.c" ~ d)
  e = "\\."; print ("a.c" ~ e), ("abc" ~ e)
}

#=== subsep_multidimensional_in_and_convfmt
# Each subscript of a multidimensional key is converted the same way a single
# subscript is: integral values exactly, everything else through CONVFMT.
#--- prog
BEGIN {
  CONVFMT = "%.2f"
  A[1.234, 2] = 1
  for (k in A) print k
  print ((1.234, 2) in A), ((1, 2) in A)
  SUBSEP = "-"
  B[1, 2] = "v"; print ((1, 2) in B), ("1-2" in B), length(B)
  delete B[1, 2]; print length(B)
}

#=== delete_whole_array
#--- prog
function clear(a) { delete a; return length(a) }
BEGIN {
  A[1] = 1; A[2] = 2
  delete A
  print length(A), (1 in A)
  B[1] = 1; print clear(B), length(B)
  delete C; print length(C)
}

#=== rs_regex_and_multichar
#--- prog
BEGIN { RS = "[0-9]+" } { print NR "[" $0 "]" } END { print "NR=" NR }
#--- in
a1b22c

#=== rs_multichar_literal
#--- prog
BEGIN { RS = "ab" } { print NR "[" $0 "]" } END { print "NR=" NR }
#--- in
XabYabZ

#=== fs_tab_versus_default_leading_blanks
#--- prog
BEGIN { FS = "\t" } { print NR, NF, "[" $1 "]", "[" $2 "]" }
#--- in
	a	b	

#=== fs_default_strips_leading_and_trailing_blanks
#--- prog
{ print NF, "[" $1 "]", "[" $NF "]" }
#--- in
   a	 b   

#=== fs_single_space_class_keeps_empty_fields
# `FS = "[ ]"` is a one-character *regex*, not the whitespace-run default, so
# leading and trailing blanks produce empty fields.
#--- prog
BEGIN { FS = "[ ]" } { print NF, "[" $1 "]", "[" $NF "]" }
#--- in
 a b 

#=== getline_all_forms_return_values
#--- prog
BEGIN {
  print "1:" (getline < "input.txt"), NF, "[" $0 "]", NR, FNR
  print "2:" (getline line < "input.txt"), line
  print "3:" (getline x < "/nonexistent/awkrs-parity-probe")
  print "4:" ("echo p q" | getline), NF, "[" $0 "]", NR
  print "5:" ("echo z" | getline v), v, NR
  close("echo p q"); close("echo z"); close("input.txt")
}
NR == 1 { print "6:" getline, "NR=" NR, "[" $0 "]" }
END { print "7:" getline, "NR=" NR }
#--- in
r1
r2

#=== close_return_values
# `close()` of a never-opened name is negative in every reference; the exit
# status of a closed pipe is reported by gawk and mawk (one-true-awk returns 0),
# which its own probe covers.
#--- prog
BEGIN {
  print (close("never-opened-by-this-probe") < 0)
  getline x < "input.txt"
  print close("input.txt")
  print (close("input.txt") < 0)
}

#=== close_pipe_reports_command_status
# gawk and mawk return the command's exit status from `close()` on a pipe;
# one-true-awk returns 0. Recorded rather than hidden.
#--- only gawk,mawk
#--- prog
BEGIN { "exit 3" | getline; print close("exit 3") }

#=== print_redirect_overwrite_versus_append
#--- prog
BEGIN {
  print "a" > "out"; print "b" > "out"; close("out")
  while ((getline l < "out") > 0) print "W:" l
  close("out")
  print "c" >> "out"; close("out")
  while ((getline l < "out") > 0) print "A:" l
}

#=== system_flushes_pending_output_first
#--- prog
BEGIN {
  print "before"
  system("echo middle")
  printf "no-newline"
  system("")
  print "after"
  print system("exit 7")
}

#=== srand_returns_previous_seed
#--- prog
BEGIN { srand(1); print srand(2), srand(3) }

#=== nf_assignment_rebuilds_record
#--- prog
BEGIN { OFS = "-" }
{
  NF = 2; print; print NF
  NF = 4; print "[" $0 "]", NF
  $0 = "p q r"; print NF, $2
}
#--- in
a b c d

#=== ofmt_applies_to_print_convfmt_to_concatenation
#--- prog
BEGIN {
  OFMT = "%.2f"; CONVFMT = "%.4f"
  x = 3.14159
  print x
  print x ""
  printf "%s\n", x
  print length(x "")
  print 100000, 2147483647
}
